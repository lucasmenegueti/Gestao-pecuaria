:r></a:p><a:p><a:pPr><a:defRPr sz="900"><a:solidFill><a:srgbClr val="424242"/></a:solidFill></a:defRPr></a:pPr><a:r><a:rPr sz="1200"/><a:t>• Continuar rentabilização das nossas áreas</a:t></a:r></a:p><a:p><a:pPr><a:defRPr sz="900"><a:solidFill><a:srgbClr val="424242"/></a:solidFill></a:defRPr></a:pPr><a:r><a:rPr sz="1200"/><a:t>• Parceiros (Vavá) não são os mais bem falados na região. Porém, topam dar garantia real - área de 50ha e também temos um contrato parrudo</a:t></a:r></a:p></a:txBody><a:tcPr/></a:tc><a:extLst><a:ext uri="{0D108BD9-81ED-4DB2-BD59-A6C34878D82A}"><a16:rowId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" val="10002"/></a:ext></a:extLst></a:tr><a:tr h="913033"><a:tc><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="1000" b="1"><a:solidFill><a:srgbClr val="2E7D32"/></a:solidFill></a:defRPr></a:pPr><a:r><a:rPr sz="1200"/><a:t>Pontos Negativos</a:t></a:r></a:p></a:txBody><a:tcPr><a:solidFill><a:srgbClr val="F1F8F4"/></a:solidFill></a:tcPr></a:tc><a:tc><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="900"><a:solidFill><a:srgbClr val="424242"/></a:solidFill></a:defRPr></a:pPr><a:r><a:rPr sz="1200"/><a:t>• Baixa intensificação</a:t></a:r></a:p></a:txBody><a:tcPr/></a:tc><a:tc><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="900"><a:solidFill><a:srgbClr val="424242"/></a:solidFill></a:defRPr></a:pPr><a:r><a:rPr sz="1200"/><a:t>• Pasto continuaria perdendo fertilidade sem reposição</a:t></a:r></a:p></a:txBody><a:tcPr/></a:tc><a:tc><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="900"><a:solidFill><a:srgbClr val="424242"/></a:solidFill></a:defRPr></a:pPr><a:endParaRPr sz="1200"/></a:p></a:txBody><a:tcPr/></a:tc><a:extLst><a:ext uri="{0D108BD9-81ED-4DB2-BD59-A6C34878D82A}"><a16:rowId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" val="10003"/></a:ext></a:extLst></a:tr><a:tr h="913033"><a:tc><a:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="1000" b="1"><a:solidFill><a