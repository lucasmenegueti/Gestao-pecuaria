# Relatório Diário da Pecuária — variáveis de ambiente.
# Copiar para .env (gitignored) e preencher. Carregar com:  set -a; source .env; set +a
# (o run_daily_report.sh já faz isso.) Na routine da nuvem, ficam no environment.

# --- Supabase: proxy + anon (mesmos do dashboard) + login de admin ---
# O relatório lê via JWT de um usuário admin (RLS libera admin). Sem service-role key.
export SUPABASE_URL=https://nsa-supa.lucas-cf1.workers.dev
export SUPABASE_ANON_KEY=
export NSA_USER=lucas
export NSA_PASS=

# --- Z-API WhatsApp (MESMOS valores do relatório financeiro / DRE-api) ---
export ZAPI_INSTANCE=
export ZAPI_TOKEN=
export ZAPI_CLIENT_TOKEN=
export WHATSAPP_PHONE=
