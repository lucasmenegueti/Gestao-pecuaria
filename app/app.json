{
  "expo": {
    "name": "Gestão Pecuária NSA",
    "slug": "gestao-pecuaria-nsa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "gestao-pecuaria",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a6b54"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nsa.gestaopecuaria"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a6b54"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nsa.gestaopecuaria",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      ["expo-router", { "root": "./src/app" }],
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso à câmera para tirar fotos das avaliações"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às fotos para anexar às avaliações"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir acesso à localização para o mapa da fazenda"
        }
      ]
    ]
  }
}
